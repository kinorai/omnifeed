#!/usr/bin/env bash
# Launch the omnifeed stack on Apple's native `container` runtime (macOS, Apple
# Silicon) — the compose-less equivalent of `docker compose up`. Apple `container`
# has no `compose` subcommand and no first-class container-to-container DNS, so
# this script plays that role: it runs the three services, resolves the upstreams'
# container IPs, and wires omnifeed to them. No `sudo`, no host DNS config.
#
#   ./scripts/container up        # start searxng + crawl4ai + omnifeed (tokenless)
#   ./scripts/container down      # stop + remove the three containers
#   ./scripts/container status    # show state / IP / health at a glance
#   ./scripts/container logs [svc] [-f]   # tail logs (svc: omnifeed|searxng|crawl4ai)
#   ./scripts/container exec <svc> [cmd…] # run a command in one service (default: sh)
#   ./scripts/container stats     # live CPU / memory of the three containers
#   ./scripts/container restart   # down + up
#   ./scripts/container update    # pull newer images, then recreate
#   ./scripts/container build     # build omnifeed from local source, then up
#   ./scripts/container mcp        # one-shot stdio MCP server (for stdio-only clients)
#
# Requires: Apple `container` (>= 1.0.0) and macOS 26 (Tahoe). Nothing else —
# no jq, no Docker. Prefer this over Docker on Apple Silicon.
set -euo pipefail
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ---- config (all overridable via env) --------------------------------------
# All three track moving tags so `update` pulls the newest build. crawl4ai 0.9.x
# serves on the network only with CRAWL4AI_API_TOKEN set (else loopback) and gates
# its API on it, and the Reddit engine needs POST /execute_js enabled — so up()
# generates a shared token, hands it to both sides, and turns on execute_js. Every
# image is overridable; `--platform` below fails fast if a tag lacks arm64.
SEARXNG_IMAGE="${SEARXNG_IMAGE:-searxng/searxng:2026.8.3-0734ee6c7}"
CRAWL4AI_IMAGE="${CRAWL4AI_IMAGE:-unclecode/crawl4ai:0.9.2}"
OMNIFEED_IMAGE="${OMNIFEED_IMAGE:-kinorai/omnifeed:latest}"
PLATFORM="${OMNIFEED_PLATFORM:-linux/arm64}"

# A name prefix lets you run this alongside the Docker stack (or a second copy)
# without colliding on container names / host ports.
PREFIX="${OMNIFEED_PREFIX:-}"
SEARXNG="${PREFIX}searxng"
CRAWL4AI="${PREFIX}crawl4ai"
OMNIFEED="${PREFIX}omnifeed"

# Host ports. omnifeed is published for you to use; crawl4ai is published so the
# health-wait can reach it (Apple `container` IPs are not routable from the host).
# searxng needs no host port — omnifeed reaches it by container IP.
PORT_HTTP="${OMNIFEED_PORT_HTTP:-8080}"       # /crawl (Open WebUI) + /search
PORT_MCP="${OMNIFEED_PORT_MCP:-8081}"         # MCP HTTP/SSE
PORT_METRICS="${OMNIFEED_PORT_METRICS:-9090}" # Prometheus + /livez /readyz
CRAWL4AI_PORT="${OMNIFEED_CRAWL4AI_PORT:-11235}"
CRAWL4AI_MEMORY="${OMNIFEED_CRAWL4AI_MEMORY:-4G}"  # headless Chromium; 1G default OOMs

# settings.yml mounted into searxng. Swapped for a rendered, gitignored runtime
# copy when a Brave Search API key is available (see render_searxng_settings).
# Point SEARXNG_SETTINGS at your own file to run a different engine pool without
# forking this repo; the Brave rendering below still applies to it.
SEARXNG_SETTINGS="${SEARXNG_SETTINGS:-$REPO/searxng/settings.yml}"

# ---- helpers ---------------------------------------------------------------
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

# Ensure the container daemon is up AND answering before issuing commands
# (at login the apiserver needs a moment — apple/container#158).
ensure_system() {
  container system start >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 15); do
    container system status >/dev/null 2>&1 && return 0
    sleep 1
  done
  warn "container system did not become ready in time"
}

exists()     { container inspect "$1" >/dev/null 2>&1; }
is_running() { exists "$1" && container inspect "$1" 2>/dev/null \
                 | grep -o '"state"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -qi running; }

# ip_of NAME -> prints the container's IPv4 (no mask); empty if unassigned.
# jq-free on purpose (macOS ships no jq): grab the ipv4Address field's dotted quad.
# `|| true`: grep exits 1 on no match, which pipefail+set -e would treat as fatal.
ip_of() {
  container inspect "$1" 2>/dev/null \
    | grep -o '"ipv4Address"[^,]*' | head -1 \
    | grep -oE '[0-9]{1,3}(\.[0-9]{1,3}){3}' | head -1 || true
}

# token_of NAME -> the container's CRAWL4AI_API_TOKEN env value (empty if none).
token_of() {
  container inspect "$1" 2>/dev/null | grep -o 'CRAWL4AI_API_TOKEN=[^"]*' | head -1 | cut -d= -f2- || true
}

# gen_token -> a fresh random hex token (openssl ships with macOS).
gen_token() { openssl rand -hex 24; }

# engines_is_last FILE — true when `engines:` is the file's last top-level key.
engines_is_last() {
  awk '/^[A-Za-z_][A-Za-z0-9_]*:/ { last = $1 } END { exit(last == "engines:" ? 0 : 1) }' "$1"
}

# env_of NAME VAR -> the value VAR was created with, empty if unset.
env_of() {
  container inspect "$1" 2>/dev/null | grep -o "$2=[^\"]*" | head -1 | cut -d= -f2- || true
}

# mount_src_of NAME DEST -> host path mounted at DEST, empty if not mounted.
# jq-free (macOS ships none). `container inspect` escapes every path slash, so
# drop the backslashes first; "destination" precedes "source" in each mount.
mount_src_of() {
  container inspect "$1" 2>/dev/null | tr -d '\\' | awk -F'"' -v dest="$2" '
    /"destination"/ { hit = ($4 == dest) }
    /"source"/      { if (hit) { print $4; exit } }'
}

# wait_http URL [tries] — poll until the endpoint answers (2s between tries).
wait_http() {
  local url="$1" tries="${2:-30}" i
  for i in $(seq 1 "$tries"); do
    curl -fsS -o /dev/null --max-time 3 "$url" 2>/dev/null && return 0
    sleep 2
  done
  return 1
}

# Start the container if it already exists, otherwise create it.
run_or_start() {
  local name="$1"; shift
  if exists "$name"; then
    log "start $name (reusing existing container)"
    container start "$name" >/dev/null 2>&1 || true
  else
    log "run   $name"
    container run -d --name "$name" --platform "$PLATFORM" "$@" >/dev/null
  fi
}

# SearXNG has no env interpolation for engine fields, so the Brave Search API key
# has to sit inside the mounted settings.yml — and the committed file must stay
# keyless. render_searxng_settings resolves the key at start time (first non-empty
# wins: $BRAVEAPI_KEY, else the output of $BRAVEAPI_KEY_COMMAND) and, if it
# finds one, renders searxng/settings.runtime.yml (gitignored, mode 600) with the
# key filled in and `inactive: true` flipped to false — inside the `- name: braveapi` block
# only. No key from either: SEARXNG_SETTINGS keeps pointing at the committed file
# and braveapi stays inactive, exactly as before. The key is never printed and never
# reaches the argv of any command (awk reads it from the environment).
#
# Store it once in whatever secret manager you already use, and point
# BRAVEAPI_KEY_COMMAND at the command that prints it. For example:
#   macOS Keychain: export BRAVEAPI_KEY_COMMAND="security find-generic-password -s omnifeed-braveapi -w"
#   Bitwarden:      export BRAVEAPI_KEY_COMMAND="bw get password omnifeed-braveapi"
render_searxng_settings() {
  local key source runtime
  if [ -n "${BRAVEAPI_KEY:-}" ]; then
    key="$BRAVEAPI_KEY"; source=env
  elif [ -n "${BRAVEAPI_KEY_COMMAND:-}" ]; then
    key="$(eval "$BRAVEAPI_KEY_COMMAND" 2>/dev/null || true)"
    source=command
  fi
  [ -n "${key:-}" ] || return 0

  # A custom SEARXNG_SETTINGS file need not declare braveapi at all. Without the
  # block there is nothing to inject into, so mount the file untouched rather
  # than render a copy that claims a key it does not carry.
  if ! grep -q '^  - name: braveapi$' "$SEARXNG_SETTINGS"; then
    warn "braveapi: no '- name: braveapi' block in $SEARXNG_SETTINGS — key not injected"
    return 0
  fi

  runtime="$REPO/searxng/settings.runtime.yml"
  rm -f "$runtime"
  ( umask 077
    BRAVEAPI_KEY_RENDER="$key" awk '
      /^  - name: braveapi$/            { inblock = 1; print; next }
      inblock && /^  - name:/           { inblock = 0 }
      inblock && /^[[:space:]]*api_key:/ {
        match($0, /^[[:space:]]*/)
        printf "%sapi_key: \"%s\"\n", substr($0, 1, RLENGTH), ENVIRON["BRAVEAPI_KEY_RENDER"]
        next
      }
      inblock && /^[[:space:]]*inactive:[[:space:]]*true[[:space:]]*$/ {
        # Must OVERRIDE, not drop: with use_default_settings, engine blocks merge
        # key-wise, so a missing `inactive` inherits the upstream default (true)
        # and the engine is silently never loaded.
        match($0, /^[[:space:]]*/)
        printf "%sinactive: false\n", substr($0, 1, RLENGTH)
        next
      }
                                        { print }
    ' "$SEARXNG_SETTINGS" > "$runtime" )
  # Two engines are redundant once the API engine is keyed — disable them in the
  # rendered copy only (merge-by-name override), never in the committed file:
  #   brave      the HTML scraper, routinely 429-suspended
  #   startpage  the pool's slowest engine and the repeat 1h-CAPTCHA offender. It
  #              proxies Google, which `google cse` already covers. Keyless users
  #              keep it: it is a free general-web engine their pool needs.
  #
  # They append at EOF so a later entry wins the merge, which requires `engines:`
  # to be the file's last top-level key. That holds for the committed file; a
  # custom SEARXNG_SETTINGS may order keys differently, and grafting list items
  # onto whatever block ends the file would break the parse. Skip it and say so.
  if engines_is_last "$runtime"; then
    printf '\n  # Rendered overrides: redundant while braveapi is keyed.\n  - name: brave\n    disabled: true\n  - name: startpage\n    disabled: true\n' >> "$runtime"
  else
    warn "braveapi: 'engines:' is not the last top-level key in $SEARXNG_SETTINGS — brave/startpage left enabled"
  fi
  chmod 600 "$runtime"
  SEARXNG_SETTINGS="$runtime"
  log "braveapi: key injected from ${source}"
}

rm_one() {
  container stop "$1" >/dev/null 2>&1 || true
  container rm   "$1" >/dev/null 2>&1 || true
}

# ---- commands --------------------------------------------------------------
up() {
  ensure_system

  # 1. Upstreams (reused if already present — crawl4ai is slow to boot).
  render_searxng_settings
  # `run` reuses an existing container, so env and mounts only apply on first
  # create. An existing searxng from before these settings would silently keep
  # the old ones — recreate it when either drifted, the same way the crawl4ai
  # token is handled below.
  if exists "$SEARXNG" \
     && [ "$(env_of "$SEARXNG" GRANIAN_BLOCKING_THREADS)" != "12" \
          -o "$(mount_src_of "$SEARXNG" /etc/searxng/settings.yml)" != "$SEARXNG_SETTINGS" ]; then
    log "searxng settings changed — recreating it"; rm_one "$SEARXNG"
  fi
  # GRANIAN_BLOCKING_THREADS: worker threads (image default 4). With 4, a 5th
  # simultaneous search queues. Searches are ~95% network wait, so the extra
  # threads cost only idle memory; the limiter is off, so this cannot trip it.
  run_or_start "$SEARXNG" \
    -e SEARXNG_SECRET=dev-only-change-me \
    -e GRANIAN_BLOCKING_THREADS=12 \
    -v "$SEARXNG_SETTINGS:/etc/searxng/settings.yml" \
    "$SEARXNG_IMAGE"

  # crawl4ai 0.9.x serves non-loopback only with CRAWL4AI_API_TOKEN set, and then
  # gates /crawl on it — so use a shared token. A running crawl4ai is the source of
  # truth (it is reused, not recreated); recreate it only when the token must change.
  local token current
  token="${OMNIFEED_CRAWL4AI_TOKEN:-}"
  if exists "$CRAWL4AI"; then
    current="$(token_of "$CRAWL4AI")"
    if [ -n "$token" ] && [ "$token" != "$current" ]; then
      log "crawl4ai token changed — recreating it"; rm_one "$CRAWL4AI"
    elif [ -z "$token" ] && [ -z "$current" ]; then
      log "existing crawl4ai has no API token — recreating it"; rm_one "$CRAWL4AI"; token="$(gen_token)"
    else
      token="${token:-$current}"
    fi
  fi
  [ -n "$token" ] || token="$(gen_token)"

  run_or_start "$CRAWL4AI" \
    -p "${CRAWL4AI_PORT}:11235" \
    -m "$CRAWL4AI_MEMORY" \
    -e "CRAWL4AI_API_TOKEN=${token}" \
    -e CRAWL4AI_EXECUTE_JS_ENABLED=true \
    -e CRAWL4AI_HOOKS_ENABLED=false \
    -e MAX_CONCURRENT_TASKS=25 \
    "$CRAWL4AI_IMAGE"

  log "waiting for crawl4ai (headless browser, ~30s first boot)…"
  wait_http "http://localhost:${CRAWL4AI_PORT}/health" 30 \
    || warn "crawl4ai not healthy yet; omnifeed will retry on its own"

  # 2. Resolve upstream IPs. omnifeed reaches them by IP over the shared network —
  #    no `container system dns` domain and no sudo required.
  local searxng_ip crawl4ai_ip
  crawl4ai_ip="$(ip_of "$CRAWL4AI")"
  searxng_ip="$(ip_of "$SEARXNG")"
  [ -n "$crawl4ai_ip" ] || die "could not resolve crawl4ai container IP (is it running?)"
  [ -n "$searxng_ip" ]  || warn "could not resolve searxng IP — web_search will be disabled"
  log "upstreams: crawl4ai=${crawl4ai_ip} searxng=${searxng_ip:-<none>}"

  # 3. omnifeed — always recreated so it is wired to the CURRENT upstream IPs.
  #    Tokenless, mirroring `docker compose up` (OMNIFEED_DEV_NO_AUTH=true).
  rm_one "$OMNIFEED"
  local env_args=(
    -e "OMNIFEED_CRAWL4AI_URL=http://${crawl4ai_ip}:11235/crawl"
    -e "OMNIFEED_CRAWL4AI_TOKEN=${token}"
    -e OMNIFEED_DEV_NO_AUTH=true
    -e OMNIFEED_LOG_LEVEL=info
    -e OMNIFEED_LOG_FORMAT=json
  )
  [ -n "$searxng_ip" ] && env_args+=( -e "OMNIFEED_SEARXNG_URL=http://${searxng_ip}:8080" )
  log "run   $OMNIFEED"
  container run -d --name "$OMNIFEED" --platform "$PLATFORM" \
    -p "${PORT_HTTP}:8080" -p "${PORT_MCP}:8081" -p "${PORT_METRICS}:9090" \
    "${env_args[@]}" \
    "$OMNIFEED_IMAGE" >/dev/null

  log "waiting for omnifeed…"
  if wait_http "http://localhost:${PORT_METRICS}/readyz" 30; then
    log "omnifeed ready → http://localhost:${PORT_HTTP}  (MCP :${PORT_MCP}/mcp · metrics :${PORT_METRICS})"
  else
    warn "omnifeed did not report ready; check:  $0 logs"
  fi
}

down() {
  rm_one "$OMNIFEED"
  rm_one "$CRAWL4AI"
  rm_one "$SEARXNG"
  log "down complete (containers removed)"
}

update() {
  ensure_system
  log "pulling latest images…"
  container image pull "$SEARXNG_IMAGE"  >/dev/null || warn "pull failed: $SEARXNG_IMAGE"
  container image pull "$CRAWL4AI_IMAGE" >/dev/null || warn "pull failed: $CRAWL4AI_IMAGE"
  container image pull "$OMNIFEED_IMAGE" >/dev/null || warn "pull failed: $OMNIFEED_IMAGE"
  log "recreating stack with updated images…"
  down
  up
}

build() {
  ensure_system
  local tag="${PREFIX}omnifeed:local"
  log "building ${tag} from ${REPO}/Dockerfile…"
  container build -t "$tag" "$REPO"
  log "starting stack with locally-built image (${tag})"
  OMNIFEED_IMAGE="$tag" up
}

logs() {
  local target="$OMNIFEED"
  case "${1:-}" in
    searxng)  target="$SEARXNG";  shift ;;
    crawl4ai) target="$CRAWL4AI"; shift ;;
    omnifeed) target="$OMNIFEED"; shift ;;
  esac
  container logs "$@" "$target"
}

# exec SVC CMD... — run a command inside one service. Reach for it when a
# container behaves unlike its config: `exec searxng sh` and read what it loaded.
# The omnifeed image is distroless and ships no shell — inspect it over HTTP
# (:9090/metrics, /livez, /readyz) or with `logs` instead.
exec_in() {
  local target
  case "${1:-}" in
    searxng)  target="$SEARXNG" ;;
    crawl4ai) target="$CRAWL4AI" ;;
    omnifeed) target="$OMNIFEED" ;;
    *) die "exec needs a service: omnifeed|searxng|crawl4ai" ;;
  esac
  shift
  [ $# -gt 0 ] || set -- sh
  # -t only when both ends are a terminal: an interactive `sh` needs a prompt and
  # line editing, but `exec searxng cat settings.yml > out.yml` must stay clean.
  # The ${a[@]+…} guard is for bash 3.2 (stock macOS): set -u aborts on a naked
  # empty-array expansion there.
  local tty=()
  { [ -t 0 ] && [ -t 1 ]; } && tty=(-t)
  exec container exec -i ${tty[@]+"${tty[@]}"} "$target" "$@"
}

# stats — live CPU / memory. Skips containers that are not running: `container
# stats` errors on a missing name, and set -e would abort the whole command.
stats() {
  ensure_system
  local n present=()
  for n in "$SEARXNG" "$CRAWL4AI" "$OMNIFEED"; do
    is_running "$n" && present+=("$n")
  done
  [ "${#present[@]}" -gt 0 ] || die "no containers running — start the stack first:  $0 up"
  container stats "${present[@]}"
}

status() {
  printf '%-12s %-9s %-16s %s\n' SERVICE STATE IP CONTAINER
  local pair label cname st
  for pair in "searxng:$SEARXNG" "crawl4ai:$CRAWL4AI" "omnifeed:$OMNIFEED"; do
    label="${pair%%:*}"; cname="${pair#*:}"
    if ! exists "$cname"; then
      printf '%-12s %-9s %-16s %s\n' "$label" absent - "$cname"
    else
      is_running "$cname" && st=running || st=stopped
      printf '%-12s %-9s %-16s %s\n' "$label" "$st" "$(ip_of "$cname")" "$cname"
    fi
  done
  echo
  if curl -fsS -o /dev/null --max-time 3 "http://localhost:${PORT_METRICS}/readyz" 2>/dev/null; then
    log "omnifeed: ready — http://localhost:${PORT_HTTP} · MCP :${PORT_MCP}/mcp · metrics :${PORT_METRICS}"
  else
    warn "omnifeed: not answering /readyz on :${PORT_METRICS}"
  fi
}

# One-shot stdio MCP server for clients that only speak stdio (Claude Desktop,
# etc.). The HTTP transport on :${PORT_MCP}/mcp already works once `up` is done,
# so prefer that. Needs the stack up (to resolve upstream IPs). Keeps stdout
# clean for JSON-RPC — status goes to stderr.
mcp() {
  local crawl4ai_ip searxng_ip token
  crawl4ai_ip="$(ip_of "$CRAWL4AI")"
  searxng_ip="$(ip_of "$SEARXNG")"
  token="$(token_of "$CRAWL4AI")"
  [ -n "$crawl4ai_ip" ] || die "crawl4ai is not running — start the stack first:  $0 up"
  local env_args=( -e "OMNIFEED_CRAWL4AI_URL=http://${crawl4ai_ip}:11235/crawl" )
  [ -n "$token" ]      && env_args+=( -e "OMNIFEED_CRAWL4AI_TOKEN=${token}" )
  [ -n "$searxng_ip" ] && env_args+=( -e "OMNIFEED_SEARXNG_URL=http://${searxng_ip}:8080" )
  exec container run --rm -i --platform "$PLATFORM" "${env_args[@]}" "$OMNIFEED_IMAGE" --mcp-stdio
}

usage() {
  # Print the header comment block (everything after the shebang up to the first
  # non-comment line), stripping the leading "# ".
  awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "${BASH_SOURCE[0]}"
}

# ---- dispatch --------------------------------------------------------------
cmd="${1:-}"; shift || true
case "$cmd" in
  up)         up ;;
  down)       down ;;
  restart)    down; up ;;
  update)     update ;;
  build)      build ;;
  logs)       logs "$@" ;;
  exec)       exec_in "$@" ;;
  stats)      stats ;;
  status|ps)  status ;;
  mcp)        mcp ;;
  ""|-h|--help|help) usage ;;
  *) warn "unknown command: $cmd"; usage; exit 1 ;;
esac
